  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window and tray panel",
  "windows": ["main", "tray-panel"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "core:app:default",
    "core:path:default",
    "core:webview:default",
    "updater:default",
    "dialog:allow-open"
  ]
}