{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pretupid Launcher",
  "version": "0.0.1",
  "identifier": "com.yannosayproductions.pretupid-launcher",
  "build": {
    "beforeDevCommand": "npm run dev --prefix C:/Users/Yannosay/Desktop/pretupid-launcher/frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix C:/Users/Yannosay/Desktop/pretupid-launcher/frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pretupid Launcher",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}