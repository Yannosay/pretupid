{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Pretupid Launcher",
    "version": "0.2.1",
    "identifier": "com.yannosayproductions.pretupid-launcher",
    "build": {
        "beforeDevCommand": "npm run dev --prefix frontend",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build --prefix frontend",
        "frontendDist": "../../frontend/dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Pretupid Launcher",
                "width": 1200,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "center": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 https://api.modrinth.com https://cdn.modrinth.com https://piston-meta.mojang.com https://resources.download.minecraft.net https://api.minecraftservices.com https://login.live.com https://user.auth.xboxlive.com https://xsts.auth.xboxlive.com https://meta.fabricmc.net https://meta.quiltmc.org https://maven.minecraftforge.net https://maven.neoforged.net https://api.adoptium.net https://api.github.com https://github.com https://objects.githubusercontent.com"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzMkVEQ0U0Qjk4RDJGQUEKUldTcUw0MjU1Tnd1UStCYXdVUThyUnpuSmIyRkEzUUxzeDdRZVpKRGRXSjAyKzV1bmdGdUZzYVkK",
            "endpoints": [
                "https://pretupid.yannosay.com/api/launcher/latest.json",
                "https://github.com/Yannosay/pretupid/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        },
        "deep-link": {
            "desktop": {
                "schemes": [
                    "pretupid"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": [
            "nsis",
            "app",
            "dmg",
            "deb",
            "rpm",
            "appimage"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "installerIcon": "icons/icon.ico"
            }
        },
        "linux": {
            "deb": {
                "depends": [
                    "libwebkit2gtk-4.1-0",
                    "libgtk-3-0"
                ]
            },
            "appimage": {
                "bundleMediaFramework": false
            }
        },
        "macOS": {
            "minimumSystemVersion": "11.0"
        },
        "category": "Game",
        "shortDescription": "Minecraft launcher with mods, modpacks and skins",
        "licenseFile": "installer-license.txt"
    }
}
