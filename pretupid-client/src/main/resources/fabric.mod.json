{
	"schemaVersion": 1,
	"id": "pretupid",
	"version": "${version}",
	"name": "Pretupid Client",
	"description": "The free all in one client",
	"authors": [
		"Yannosay Productions"
	],
	"contact": {
		"homepage": "https://pretupid.net",
		"sources": "https://github.com/Yannosay/pretupid",
		"issues": "https://github.com/Yannosay/pretupid/issues"
	},
	"license": "AGPL-3.0-only",
	"icon": "assets/pretupid/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.pretupid.client.PretupidClient"
		]
	},
	"mixins": [
		"pretupid.mixins.json",
		"pretupid.platform.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.website": "https://pretupid.net"
			}
		}
	}
}
